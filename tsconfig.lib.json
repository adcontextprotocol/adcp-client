{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/lib",
    "rootDir": "./src/lib",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "stripInternal": true
  },
  "include": ["src/lib/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.type-checks.ts"]
}
