{
  "name": "@adcp/reference-renderers",
  "version": "0.0.0",
  "description": "Browser-safe reference presentations for AdCP canonical creative formats",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
